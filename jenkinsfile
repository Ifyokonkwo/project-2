pipeline {
    agent any

    parameters {
        string(
            name: 'ANSIBLE_PRIVATE_IP',
            defaultValue: '10.0.1.44',
            description: 'Private IP address of the Ansible control node'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'euteam2',
                    url: 'https://github.com/CloudHight/application-assessment-repo.git'
            }
        }

        stage('Display Ansible Server IP') {
            steps {
                echo "Ansible Server IP: ${params.ANSIBLE_PRIVATE_IP}"
            }
        }

        stage('Code Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh "mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar"
                }
            }
        }

        stage('Sonarqube Quality Gate') {
            steps {
                timeout(time: 2, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Dependency Check') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'nvd-key',
                        variable: 'NVD_KEY'
                    )
                ]) {
                    dependencyCheck(
                        additionalArguments: "--scan ./ --nvdApiKey $NVD_KEY",
                        odcInstallation: 'DP-Check'
                    )
                }

                dependencyCheckPublisher(
                    pattern: '**/dependency-check-report.xml'
                )
            }
        }

        stage('Building Artifact with Maven') {
            steps {
                sh 'mvn -f pom.xml clean package -DskipTests -Dcheckstyle.skip'
            }
        }

        stage('Push Artifact to Nexus Repo') {
            steps {
                nexusArtifactUploader(
                    artifacts: [[
                        artifactId: 'spring-petclinic',
                        classifier: '',
                        file: 'target/spring-petclinic-2.4.2.war',
                        type: 'war'
                    ]],
                    credentialsId: 'nexus-cred',
                    groupId: 'Petclinic',
                    nexusUrl: 'nexus.ifeanyi-okonkwo-05-training.com',
                    nexusVersion: 'nexus3',
                    protocol: 'https',
                    repository: 'maven-repo',
                    version: '1.0'
                )
            }
        }

        stage('Build Docker Image on the Ansible Server') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-docker-credentials',
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sshagent(['ansible-key']) {
                        sh '''
                            ssh -t -t ubuntu@${ANSIBLE_PRIVATE_IP} \
                            -o StrictHostKeyChecking=no \
                            "ansible-playbook /opt/scripts/docker-image.yml \
                            -e nexus_username='${NEXUS_USERNAME}' \
                            -e nexus_password='${NEXUS_PASSWORD}'"
                        '''
                    }
                }
            }
        }

        stage('Deploy to Stage Env') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-docker-credentials',
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sshagent(['ansible-key']) {
                        sh '''
                            ssh -t -t ubuntu@${ANSIBLE_PRIVATE_IP} \
                            -o StrictHostKeyChecking=no \
                            "ansible-playbook /opt/scripts/docker-container.yml \
                            --limit stage_env \
                            -e nexus_username='${NEXUS_USERNAME}' \
                            -e nexus_password='${NEXUS_PASSWORD}'"
                        '''
                    }
                }
            }
        }

        stage('Check Website Availability') {
            steps {
                sh 'sleep 90'

                script {
                    def response = sh(
                        script: 'curl -s -o /dev/null -w "%{http_code}" https://stage.ifeanyi-okonkwo-05-training.com/',
                        returnStdout: true
                    ).trim()

                    echo "Stage website HTTP status code: ${response}"

                    if (response == "200") {
                        slackSend(
                            color: 'good',
                            message: "The stage petclinic java application is up and running with HTTP status code ${response}.",
                            tokenCredentialId: 'slack'
                        )
                    } else {
                        slackSend(
                            color: 'danger',
                            message: "The stage petclinic java application appears to be down with HTTP status code ${response}.",
                            tokenCredentialId: 'slack'
                        )

                        error("Stage application health check failed with HTTP status code ${response}.")
                    }
                }
            }
        }

        stage('Request for Approval') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    input(
                        message: 'Needs Approval Before Deployment to Production',
                        submitter: 'admin'
                    )
                }
            }
        }

        stage('Deploy to Production Env') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-docker-credentials',
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sshagent(['ansible-key']) {
                        sh '''
                            ssh -t -t ubuntu@${ANSIBLE_PRIVATE_IP} \
                            -o StrictHostKeyChecking=no \
                            "ansible-playbook /opt/scripts/docker-container.yml \
                            --limit prod_env \
                            -e nexus_username='${NEXUS_USERNAME}' \
                            -e nexus_password='${NEXUS_PASSWORD}'"
                        '''
                    }
                }
            }
        }
    }
}
